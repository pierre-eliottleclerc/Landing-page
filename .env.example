# Copier ce fichier en .env.local (ignoré par Git) et renseigner les valeurs.
# Sur Vercel, les définir dans Settings → Environment Variables.

# URL du projet Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co

# Clé PUBLIABLE (sb_publishable_…). Destinée à être exposée au navigateur :
# ce sont les politiques RLS qui protègent les données, pas le secret de la clé.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# NE JAMAIS mettre ici de clé sb_secret_… : elle contourne le RLS et donnerait
# un accès administrateur complet à la base. Si un usage serveur l'exige un jour,
# la définir uniquement dans Vercel, sans le préfixe NEXT_PUBLIC_.

# URL publique du site, utilisée pour les URL canoniques et le sitemap.
NEXT_PUBLIC_SITE_URL=https://florestan-im.com
